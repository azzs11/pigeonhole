  "components": {
    "schemas": {
      "AgentSendResult": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AgentSendStatus"
          },
          "messageId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "approvalId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "riskScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 0
          },
          "reasons": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "recipients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RecipientVerdict"
            }
          },
          "guardMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double",
            "default": 0
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "preview": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SendPreview"
              }
            ]
          }
        }
      },
      "AgentSendStatus": {
        "enum": [
          "Sent",
          "Held",
          "Blocked",
          "Duplicate",
          "DryRun",
          "Invalid",
          "Refused",
          "NotFound"
        ]
      },
      "ApprovalAsk": {
        "required": [
          "message",
          "reason"
        ],
        "type": "object",
        "properties": {
          "message": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ApprovalRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "riskScore": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "description": "\"guard\" when the Guard held it, \"agent\" when the agent asked."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "decidedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "decidedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "A held message waiting for a human. Created by the Guard or by the agent asking."
      },
      "ApprovalStatus": {
        "enum": [
          "Pending",
          "Approved",
          "Rejected",
          "Expired"
        ]
      },
      "BatchRequest": {
        "type": "object",
        "properties": {
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 200
          }
        }
      },
      "BatchResult": {
        "required": [
          "accepted"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "BounceResult": {
        "required": [
          "result"
        ],
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "BulkResponse": {
        "required": [
          "messages"
        ],
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          }
        }
      },
      "CreateRunRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "trustedRecipients": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/GuardPolicy"
              }
            ]
          },
          "ttlMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DecisionRequest": {
        "required": [
          "note"
        ],
        "type": "object",
        "properties": {
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExplainedStep": {
        "required": [
          "at",
          "from",
          "to",
          "explanation"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageStatus"
              }
            ]
          },
          "to": {
            "$ref": "#/components/schemas/MessageStatus"
          },
          "explanation": {
            "type": "string"
          }
        }
      },
      "Explanation": {
        "required": [
          "status",
          "summary",
          "steps"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/MessageStatus"
          },
          "summary": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
