root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Language preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_readonly_field = true:warning

# Naming: constants and static readonly fields are PascalCase; other private fields are _camelCase
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_symbols.static_readonly.applicable_kinds = field
dotnet_naming_symbols.static_readonly.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Analyzer tuning (AnalysisLevel = latest-all) ---
# Each suppression below has a reason. Do not add one without a reason.

# ASP.NET Core has no SynchronizationContext, so ConfigureAwait(false) is noise.
dotnet_diagnostic.CA2007.severity = none
# Logging source generators arrive with Serilog/OpenTelemetry in Phase 4.
dotnet_diagnostic.CA1848.severity = suggestion
# Culture-specific formatting: the service is invariant-culture throughout.
dotnet_diagnostic.CA1305.severity = suggestion
# Domain entities are EF Core-shaped (settable collections, List<T>); revisit in Phase 1.
dotnet_diagnostic.CA2227.severity = suggestion
dotnet_diagnostic.CA1002.severity = suggestion
# Domain names like "Email" in "Email.Email" are intentional.
dotnet_diagnostic.CA1724.severity = suggestion
# DI and EF create internal types by reflection; CA1812 cannot see that.
dotnet_diagnostic.CA1812.severity = none
# No localisation: console and error text are literals by design.
dotnet_diagnostic.CA1303.severity = none

[src/Relay.Infrastructure/Migrations/**.cs]
generated_code = true

[tests/**.cs]
# HttpClient string overloads are idiomatic in tests.
dotnet_diagnostic.CA2234.severity = none
# Inline constant arrays in test data are fine.
dotnet_diagnostic.CA1861.severity = none
# Test method names use underscores: Method_Condition_Result.
dotnet_diagnostic.CA1707.severity = none
# Test classes must be public for xUnit.
dotnet_diagnostic.CA1515.severity = none
